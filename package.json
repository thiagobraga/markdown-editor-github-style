{
  "name": "markdown-editor-github-style",
  "displayName": "Markdown Editor Github Style",
  "description": "Realtime WYSIWYG markdown editing that looks like GitHub Pages — the new inline markdown editor experience rendered with GitHub's own light styling.",
  "version": "0.1.1",
  "publisher": "your-publisher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "github",
    "wiki",
    "wysiwyg",
    "preview"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:githubStyle.markdownEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "githubStyle.markdownEditor",
        "displayName": "Markdown Editor Github Style",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src webview test",
    "test": "vitest run",
    "test:integration": "npm run compile && tsc -p tsconfig.test.json && vscode-test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@vscode/markdown-editor": "0.0.2-0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.100.0",
    "@vscode/observables": "0.1.1-0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-user/markdown-editor-github-style"
  }
}
